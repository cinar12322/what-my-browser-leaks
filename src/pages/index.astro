---
import Layout from '../layouts/Layout.astro';
import LegalModals from '../components/LegalModals.astro';
---

<Layout title="FingerprintGuard — Client-Side Browser Fingerprint Inspector">
  <div class="min-h-screen flex flex-col bg-[#0c0e14] text-[#f0f3fa]">
    
    <!-- TOP NAVIGATION BAR -->
    <header class="sticky top-0 z-40 bg-[#0c0e14]/95 border-b border-[#1e2436] backdrop-blur px-4 sm:px-8 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded bg-[#131722] border border-[#2f3854] flex items-center justify-center text-[#00d2f0]">
          <span class="material-symbols-outlined text-[18px]">security</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm tracking-tight text-white">FingerprintGuard</span>
          <span class="text-[10px] font-mono uppercase bg-[#181d2b] border border-[#2f3854] text-[#9aa5be] px-1.5 py-0.5 rounded">v4.2 LOCAL</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <button id="btn-copy-markdown" class="px-2.5 py-1 text-xs font-mono rounded bg-[#131722] hover:bg-[#181d2b] text-[#9aa5be] hover:text-white border border-[#1e2436] transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[14px] text-[#00d2f0]">content_copy</span>
          <span class="hidden sm:inline">Copy Report</span>
        </button>
        <button id="btn-download-json" class="px-2.5 py-1 text-xs font-mono rounded bg-[#131722] hover:bg-[#181d2b] text-[#9aa5be] hover:text-white border border-[#1e2436] transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[14px] text-[#10b981]">download</span>
          <span class="hidden sm:inline">JSON</span>
        </button>
        <button id="btn-rescan-all" class="px-3 py-1 text-xs font-mono font-medium rounded bg-[#00d2f0] hover:bg-[#38e1fa] text-[#041d24] transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px]">refresh</span>
          <span>Re-scan</span>
        </button>
      </div>
    </header>

    <!-- MAIN DASHBOARD CONTENT -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-8 flex flex-col gap-6">

      <!-- HERO STATUS BANNER -->
      <section class="console-card p-6 flex flex-col lg:flex-row gap-6 items-stretch justify-between">
        <div class="flex-1 flex flex-col justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
              <span class="font-mono text-xs text-[#10b981] font-medium tracking-wide">ZERO-EGRESS CLIENT INSPECTOR</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Browser Fingerprint Analysis</h1>
            <p class="text-xs sm:text-sm text-[#9aa5be] mt-1 max-w-2xl leading-relaxed">
              Calculates your device identifiability using Canvas rasterization, WebGL GPU parameters, AudioContext DSP frequency curves, and operating system fonts without cookies or trackers.
            </p>
          </div>

          <!-- Real-Time Metrics Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2">
            <div class="p-3 rounded bg-[#0c0e14] border border-[#1e2436]">
              <span class="block font-mono text-[10px] text-[#5e6982]">AUDITED APIS</span>
              <span class="text-lg font-bold font-mono text-white" id="metric-audited-count">54 APIs</span>
            </div>
            <div class="p-3 rounded bg-[#0c0e14] border border-[#1e2436]">
              <span class="block font-mono text-[10px] text-[#5e6982]">CALCULATED ENTROPY</span>
              <span class="text-lg font-bold font-mono text-[#00d2f0]" id="metric-entropy-bits">-- bits</span>
            </div>
            <div class="p-3 rounded bg-[#0c0e14] border border-[#1e2436]">
              <span class="block font-mono text-[10px] text-[#5e6982]">INSTALLED FONTS</span>
              <span class="text-lg font-bold font-mono text-[#10b981]" id="metric-fonts-found">Testing</span>
            </div>
            <div class="p-3 rounded bg-[#0c0e14] border border-[#1e2436]">
              <span class="block font-mono text-[10px] text-[#5e6982]">SPOOFING ANOMALIES</span>
              <span class="text-lg font-bold font-mono text-[#10b981]" id="metric-consistency-badge">Clean</span>
            </div>
          </div>
        </div>

        <!-- Gauge & Identifiability Score -->
        <div class="w-full lg:w-72 p-4 rounded bg-[#0c0e14] border border-[#1e2436] flex flex-col items-center justify-center text-center">
          <div class="relative w-32 h-32 flex items-center justify-center">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 120 120">
              <circle class="text-[#181d2b]" cx="60" cy="60" fill="none" r="50" stroke="currentColor" stroke-width="8"></circle>
              <circle 
                id="uniqueness-gauge-circle"
                class="text-[#00d2f0] transition-all duration-700 ease-out" 
                cx="60" 
                cy="60" 
                fill="none" 
                r="50" 
                stroke="currentColor" 
                stroke-width="8" 
                stroke-linecap="round"
                stroke-dasharray="314.159" 
                stroke-dashoffset="314.159"
              ></circle>
            </svg>
            <div class="absolute flex flex-col items-center justify-center">
              <span class="text-3xl font-extrabold font-mono text-white" id="gauge-score-value">--</span>
              <span class="font-mono text-[9px] text-[#5e6982] tracking-wider uppercase">Uniqueness</span>
            </div>
          </div>
          <div class="mt-2.5">
            <span class="text-xs font-semibold text-white block" id="gauge-status-title">Computing...</span>
            <p class="text-[11px] text-[#9aa5be] mt-0.5 leading-normal" id="gauge-status-desc">
              Measuring hardware signals and sub-pixel renders.
            </p>
          </div>
        </div>
      </section>

      <!-- SEARCH & CATEGORY FILTER BAR -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-2">
        <div class="relative max-w-sm w-full">
          <span class="material-symbols-outlined absolute left-2.5 top-2 text-[#5e6982] text-[16px]">search</span>
          <input 
            type="text" 
            id="audit-search-input"
            class="w-full bg-[#131722] pl-8 pr-3 py-1.5 rounded border border-[#1e2436] font-mono text-xs text-white placeholder-[#5e6982] focus:border-[#00d2f0] focus:outline-none transition-colors"
            placeholder="Filter signal or parameter..." 
          />
        </div>

        <div class="flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0" id="filter-pill-container">
          <button class="category-pill active-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono font-medium bg-[#00d2f0] text-[#041d24]" data-cat="all">All (15)</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-browser">Browser</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-screen">Display</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-hardware">Hardware</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-canvas">Canvas</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-webgl">WebGL</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-audio">Audio</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-fonts">Fonts</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-webrtc">WebRTC</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-network">Network</button>
          <button class="category-pill whitespace-nowrap px-2.5 py-1 rounded text-xs font-mono text-[#9aa5be] hover:bg-[#181d2b] hover:text-white" data-cat="cat-storage">APIs</button>
        </div>
      </div>

      <!-- 15 AUDIT MODULE CARDS (3 Columns Grid) -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="cards-grid">

        <!-- 1. Browser Core -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-browser">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">terminal</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">1. Browser Core</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f43f5e] bg-[#f43f5e]/10 border border-[#f43f5e]/20 px-1.5 py-0.5 rounded">High Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-browser-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>User-Agent String</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-browser-rows">Copy</button>
          </div>
        </div>

        <!-- 2. Screen & Viewport -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-screen">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">desktop_windows</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">2. Screen & Viewport</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f59e0b] bg-[#f59e0b]/10 border border-[#f59e0b]/20 px-1.5 py-0.5 rounded">Medium Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-screen-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>Resolution & DPR</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-screen-rows">Copy</button>
          </div>
        </div>

        <!-- 3. Hardware & Battery -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-hardware">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">memory</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">3. Hardware & Cores</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f59e0b] bg-[#f59e0b]/10 border border-[#f59e0b]/20 px-1.5 py-0.5 rounded">Medium Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-hardware-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>CPU & Battery APIs</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-hardware-rows">Copy</button>
          </div>
        </div>

        <!-- 4. Locale & DateTime -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-locale">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">schedule</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">4. Time & Locale</h2>
              </div>
              <span class="font-mono text-[10px] text-[#10b981] bg-[#10b981]/10 border border-[#10b981]/20 px-1.5 py-0.5 rounded">Low Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-locale-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>Timezone & Formatting</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-locale-rows">Copy</button>
          </div>
        </div>

        <!-- 5. Canvas Fingerprint -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-canvas">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#f43f5e]">draw</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">5. Canvas Render</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f43f5e] bg-[#f43f5e]/10 border border-[#f43f5e]/20 px-1.5 py-0.5 rounded">Critical</span>
            </div>
            
            <!-- Real Canvas Pixel Preview -->
            <div class="p-2 bg-[#0c0e14] border border-[#1e2436] rounded mb-2 flex items-center justify-between">
              <canvas id="canvas-fingerprint-preview" width="130" height="36" class="rounded bg-[#08090d]"></canvas>
              <span class="font-mono text-[10px] text-[#5e6982]">Sub-Pixel Render</span>
            </div>

            <div class="flex flex-col text-left" id="card-canvas-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>Rasterization Variance</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-canvas-rows">Copy</button>
          </div>
        </div>

        <!-- 6. WebGL GPU -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-webgl">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#f43f5e]">view_in_ar</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">6. WebGL Graphics</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f43f5e] bg-[#f43f5e]/10 border border-[#f43f5e]/20 px-1.5 py-0.5 rounded">Critical</span>
            </div>
            <div class="flex flex-col text-left" id="card-webgl-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>Unmasked GPU Model</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-webgl-rows">Copy</button>
          </div>
        </div>

        <!-- 7. Audio DSP -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-audio">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">graphic_eq</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">7. Audio Subsystem</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f43f5e] bg-[#f43f5e]/10 border border-[#f43f5e]/20 px-1.5 py-0.5 rounded">High Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-audio-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>DSP Floating Point Latency</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-audio-rows">Copy</button>
          </div>
        </div>

        <!-- 8. Fonts -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-fonts">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">format_size</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">8. System Fonts</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f59e0b] bg-[#f59e0b]/10 border border-[#f59e0b]/20 px-1.5 py-0.5 rounded">Medium Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-fonts-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>Font Glyph Detection</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-fonts-rows">Copy</button>
          </div>
        </div>

        <!-- 9. WebRTC -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-webrtc">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#f43f5e]">lan</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">9. WebRTC Leak</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f43f5e] bg-[#f43f5e]/10 border border-[#f43f5e]/20 px-1.5 py-0.5 rounded">Network Leak</span>
            </div>
            <div class="flex flex-col text-left" id="card-webrtc-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>STUN Local ICE Reflection</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-webrtc-rows">Copy</button>
          </div>
        </div>

        <!-- 10. Public IP -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-network">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#10b981]">public</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">10. Public IP (Optional)</h2>
              </div>
              <span class="font-mono text-[10px] text-[#10b981] bg-[#10b981]/10 border border-[#10b981]/20 px-1.5 py-0.5 rounded">Zero Egress</span>
            </div>
            <div class="flex flex-col text-left" id="card-network-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono">
            <span class="text-[#5e6982]">Query On Demand</span>
            <button id="btn-request-ip" class="text-[#10b981] hover:underline font-semibold">Fetch Public IP</button>
          </div>
        </div>

        <!-- 11. Storage & APIs -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-storage">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">storage</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">11. Storage & APIs</h2>
              </div>
              <span class="font-mono text-[10px] text-[#f59e0b] bg-[#f59e0b]/10 border border-[#f59e0b]/20 px-1.5 py-0.5 rounded">Medium Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-storage-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>WebGPU & Device APIs</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-storage-rows">Copy</button>
          </div>
        </div>

        <!-- 12. Codecs -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-codecs">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-[#00d2f0]">video_settings</span>
                <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-white">12. Media Codecs</h2>
              </div>
              <span class="font-mono text-[10px] text-[#10b981] bg-[#10b981]/10 border border-[#10b981]/20 px-1.5 py-0.5 rounded">Low Entropy</span>
            </div>
            <div class="flex flex-col text-left" id="card-codecs-rows"></div>
          </div>
          <div class="mt-3 pt-2 border-t border-[#1e2436] flex items-center justify-between text-[11px] font-mono text-[#5e6982]">
            <span>AV1, VP9, H.264 & DRM</span>
            <button class="copy-card-btn text-[#00d2f0] hover:underline" data-target="card-codecs-rows">Copy</button>
          </div>
        </div>

        <!-- 13. Behavioral Biometrics -->
        <div class="audit-card console-card p-4 flex flex-col justify-between" data-category="cat-behavior">
          <div>
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-[#1e2436]">
              <div class="flex items-center gap-2">
