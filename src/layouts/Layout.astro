---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = "FingerprintGuard — Browser Fingerprint & Privacy Audit" } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=JetBrains+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0f131c] text-[#dfe2ef] antialiased font-sans min-h-screen selection:bg-[#4cd7f6]/30 selection:text-[#4cd7f6]">
    <slot />
  </body>
</html>
