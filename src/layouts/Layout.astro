---
interface Props {
  title?: string;
}
const { title = "FingerprintGuard — Client-Side Browser Fingerprint Inspector" } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- System UI Fonts only: 100% Zero-Egress, No Google CDN requests -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0c0e14] text-[#f0f3fa] antialiased font-sans min-h-screen selection:bg-[#00d2f0]/30 selection:text-[#00d2f0]">
    <slot />
  </body>
</html>
