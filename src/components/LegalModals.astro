---
---
<!-- Privacy Policy & Terms Modals (Zero-Egress Compliant) -->
<div id="privacy-policy-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="console-card w-full max-w-2xl p-6 rounded-lg border border-[#2f3854] flex flex-col gap-4 max-h-[85vh] overflow-y-auto bg-[#131722]">
    <div class="flex items-center justify-between pb-3 border-b border-[#1e2436]">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px] text-[#10b981]">verified_user</span>
        <h3 class="text-sm font-bold font-mono uppercase text-white">Privacy Policy</h3>
      </div>
      <button id="btn-close-privacy" class="text-[#5e6982] hover:text-white">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <div class="text-xs text-[#9aa5be] leading-relaxed flex flex-col gap-3 font-sans">
      <p><strong class="text-white">Zero-Egress Guarantee:</strong> FingerprintGuard executes entirely within your local browser runtime. No hashes, IP addresses, canvas renders, or hardware properties are ever transmitted to any remote server or stored in external databases.</p>
      
      <p><strong class="text-white">No Third-Party Asset CDN:</strong> Unlike typical web apps, this project uses no external Google Fonts or telemetry trackers. All styles and typography are resolved from local system fonts to preserve absolute network isolation.</p>

      <p><strong class="text-white">Optional Public IP Query:</strong> The public IP lookup only executes when you explicitly click the "Fetch Public IP" button, querying <code class="text-[#00d2f0]">api.ipify.org</code> directly from your client.</p>
    </div>

    <div class="flex justify-end pt-3 border-t border-[#1e2436]">
      <button id="btn-dismiss-privacy" class="py-1 px-4 rounded bg-[#181d2b] hover:bg-[#262a34] text-white text-xs font-mono">
        Close
      </button>
    </div>
  </div>
</div>

<!-- Terms of Service Modal -->
<div id="terms-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="console-card w-full max-w-2xl p-6 rounded-lg border border-[#2f3854] flex flex-col gap-4 max-h-[85vh] overflow-y-auto bg-[#131722]">
    <div class="flex items-center justify-between pb-3 border-b border-[#1e2436]">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px] text-[#00d2f0]">gavel</span>
        <h3 class="text-sm font-bold font-mono uppercase text-white">Terms of Service</h3>
      </div>
      <button id="btn-close-terms" class="text-[#5e6982] hover:text-white">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <div class="text-xs text-[#9aa5be] leading-relaxed flex flex-col gap-3 font-sans">
      <p><strong class="text-white">Educational & Security Research:</strong> This tool is provided solely for defensive privacy assessment and browser security research.</p>
      <p><strong class="text-white">Prohibited Use:</strong> Adapting this code for non-consensual surveillance, commercial user tracking, or fraud against third parties is prohibited.</p>
      <p><strong class="text-white">Disclaimer:</strong> Entropy calculations are modeled on EFF Panopticlick heuristics. No warranty is provided for immunity against specialized tracking vendors.</p>
    </div>

    <div class="flex justify-end pt-3 border-t border-[#1e2436]">
      <button id="btn-dismiss-terms" class="py-1 px-4 rounded bg-[#181d2b] hover:bg-[#262a34] text-white text-xs font-mono">
        Close
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const privacyModal = document.getElementById('privacy-policy-modal');
    const termsModal = document.getElementById('terms-modal');

    const footerPrivacy = document.getElementById('footer-privacy-btn');
    const footerTerms = document.getElementById('footer-terms-btn');
    const btnClosePrivacy = document.getElementById('btn-close-privacy');
    const btnDismissPrivacy = document.getElementById('btn-dismiss-privacy');
    const btnCloseTerms = document.getElementById('btn-close-terms');
    const btnDismissTerms = document.getElementById('btn-dismiss-terms');

    function openModal(modal) {
      if (modal) modal.classList.remove('opacity-0', 'pointer-events-none');
    }
    function closeModal(modal) {
      if (modal) modal.classList.add('opacity-0', 'pointer-events-none');
    }

    if (footerPrivacy) footerPrivacy.addEventListener('click', () => openModal(privacyModal));
    if (footerTerms) footerTerms.addEventListener('click', () => openModal(termsModal));
    if (btnClosePrivacy) btnClosePrivacy.addEventListener('click', () => closeModal(privacyModal));
    if (btnDismissPrivacy) btnDismissPrivacy.addEventListener('click', () => closeModal(privacyModal));
    if (btnCloseTerms) btnCloseTerms.addEventListener('click', () => closeModal(termsModal));
    if (btnDismissTerms) btnDismissTerms.addEventListener('click', () => closeModal(termsModal));
  })();
</script>
